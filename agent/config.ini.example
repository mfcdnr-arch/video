[server]
# IP-адрес или hostname сервера Digital Signage
host = 10.0.119.100
port = 80
# Токен этого мини ПК (выдаётся при регистрации)
token = ЗАМЕНИТЕ_НА_ТОКЕН

[player]
# Директория для хранения медиафайлов
media_dir = /opt/ds-agent/media
# Путь к бинарнику плеера (mpv). Управление — через IPC Unix-сокет.
player_bin = /usr/bin/mpv
# Держать видео поверх окон окружения и без рамки (--ontop --no-border).
# На fly-wm (Astra) одного полноэкранного режима не всегда хватает.
# Поставьте false, если поверх-режим мешает на конкретном железе.
player_ontop = true

[schedule]
# Как часто опрашивать расписание (секунды)
poll_interval = 60
# Как часто слать heartbeat (секунды)
heartbeat_interval = 30
# Как часто проверять команды (секунды)
command_poll_interval = 5

[sync]
# Задержка перед синхронным стартом (секунды) — должна быть > latency сети
sync_delay = 3

[logging]
level = INFO
file = /var/log/ds-agent/ds-agent.log
max_bytes = 10485760
backup_count = 5
