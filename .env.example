# ============================================================
# ШАБЛОН переменных окружения Digital Signage.
# НЕ хранит реальные секреты. Настоящий .env создаётся
# автоматически скриптом install_server.sh (со случайными
# паролями и SECRET_KEY) и в репозиторий НЕ попадает (.gitignore).
#
# Этот файл нужен как справка: какие переменные существуют
# и что означают. Копировать вручную обычно не требуется.
# ============================================================

# --- База данных PostgreSQL ---
POSTGRES_DB=display_system
POSTGRES_USER=display_user
DB_PASSWORD=ЗАМЕНИТЬ_случайным_паролем        # openssl rand -hex 16

# --- Объектное хранилище MinIO (резервные копии медиа) ---
MINIO_USER=ds_minio
MINIO_PASSWORD=ЗАМЕНИТЬ_случайным_паролем      # openssl rand -hex 16

# --- Подпись токенов входа (JWT) ---
# КРИТИЧНО: на каждом сервере должен быть СВОЙ случайный ключ.
# Утечка = возможность подделать админский вход в обход пароля.
SECRET_KEY=ЗАМЕНИТЬ_случайным_ключом           # openssl rand -hex 32

# ------------------------------------------------------------
# Необязательные (есть значения по умолчанию в коде):
# BACKUP_KEEP=14            # сколько ночных дампов БД хранить
# ARCHIVE_AFTER_DAYS=365    # через сколько дней play_log уходит в архив
# MINIO_MEDIA_BUCKET=ds-media-backup
# ------------------------------------------------------------
